class Vehicle
{
    void start()
    {
        System.out.println("Vehicle is starting");
    }
}

class Car extends Vehicle
{
    void display()
    {
        System.out.println("This is a Car");
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Car c = new Car();

        c.start();
        c.display();
    }
}
