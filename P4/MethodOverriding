class Employee
{
    double calculatePay()
    {
        return 10000;
    }
}

class Manager extends Employee
{
    @Override
    double calculatePay()
    {
        return 50000;
    }
}

class Clerk extends Employee
{
    @Override
    double calculatePay()
    {
        return 20000;
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Employee e;

        e = new Manager();
        System.out.println("Manager Pay: " + e.calculatePay());

        e = new Clerk();
        System.out.println("Clerk Pay: " + e.calculatePay());
    }
}
